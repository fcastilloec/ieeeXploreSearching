{
  "$schema": "https://biomejs.dev/schemas/2.6.3/schema.json",
  "vcs": {
    "enabled": true,
    "clientKind": "git",
    "useIgnoreFile": true
  },
  "files": {
    "includes": [
      "**",
      "!!**/dist",
      "!!**/artifacts",
      "!!CHANGELOG.md"
    ]
  },
  "formatter": {
    "includes": [
      "**",
      "!!**/test/fixtures"
    ],
    "enabled": true,
    "formatWithErrors": false,
    "indentStyle": "space",
    "indentWidth": 2,
    "lineEnding": "lf",
    "lineWidth": 120,
    "bracketSpacing": true,
    "expand": "auto"
  },
  "linter": {
    "enabled": true,
    "rules": {
      "preset": "recommended"
    }
  },
  "javascript": {
    "globals": [
      "test",
      "expect"
    ],
    "formatter": {
      "quoteStyle": "single"
    }
  },
  "json": {
    "formatter": {
      "expand": "always"
    }
  },
  "yaml": {
    "formatter": {
      "quoteStyle": "single"
    }
  }
}
